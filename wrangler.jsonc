// Visit2 Worker. Not deployed yet: for now the project lives only on GitHub and runs locally (npm run dev, npm test).
// Before the first deploy: create the D1 database and put its id below, and add the routes for *.visit2.ge.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visit2",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  // daily at 03:17 UTC: data retention (src/db/retention.js)
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "visit2", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "vars": {
    // the platform's own host names; everything else is looked up in the domains table
    "PLATFORM_HOSTS": "visit2.ge,www.visit2.ge,app.visit2.ge,localhost,127.0.0.1",
    // local development: {slug}.localhost:8787 serves that hotel
    "DEV_SUFFIX": ".localhost",
    // preview before visit2.ge is bought: /h/{slug}/ on these hosts serves that hotel
    "PREVIEW_HOSTS": "*.workers.dev,localhost,127.0.0.1"
  }
}
