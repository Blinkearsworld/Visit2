// Visit2 Worker. Not deployed yet: for now the project lives only on GitHub and runs locally (npm run dev, npm test).
// Before the first deploy: create the D1 database and put its id below, and add the routes for *.visit2.ge.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visit2",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  // daily at 03:17 UTC: data retention (src/db/retention.js)
  "triggers": { "crons": ["17 3 * * *", "23 * * * *"] },
  // visit2.ge: the platform; {slug}.visit2.ge: each hotel's site (needs a proxied "*" DNS record)
  "routes": [
    { "pattern": "visit2.ge", "custom_domain": true },
    { "pattern": "www.visit2.ge", "custom_domain": true },
    { "pattern": "*.visit2.ge/*", "zone_name": "visit2.ge" },
    // hotels' own domains (villajiji.com) arrive as Cloudflare for SaaS custom hostnames on the visit2.ge zone
    { "pattern": "*/*", "zone_name": "visit2.ge" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "visit2", "database_id": "4a62c23d-9361-4fff-b13c-9ca64a29d630", "migrations_dir": "migrations" }
  ],
  "vars": {
    // the platform's own host names; everything else is looked up in the domains table
    "PLATFORM_HOSTS": "visit2.ge,www.visit2.ge,app.visit2.ge,localhost,127.0.0.1",
    // local development: {slug}.localhost:8787 serves that hotel
    "DEV_SUFFIX": ".localhost",
    // preview before visit2.ge is bought: /h/{slug}/ on these hosts serves that hotel
    "PREVIEW_HOSTS": "*.workers.dev,localhost,127.0.0.1",
    // Villa JIJI's old database (another Cloudflare account), read once to move the hotel here;
    // the read-only token is the secret JIJI_D1_TOKEN
    "JIJI_ACCOUNT": "ce5fd1160511630e42abc8e2cc33b923",
    "JIJI_DB_ID": "7f6ad11d-87af-4837-84ca-02cc99b0ac9a"
  }
}
